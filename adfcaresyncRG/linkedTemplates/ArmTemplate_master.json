{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfcaresyncRG"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0928-191302-rof839ul"
		},
		"CareSync_KeyVault_LinkedService_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://CareSyncDB.vault.azure.net/"
		},
		"CareSync_LinkedService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncsprojectstorage.dfs.core.windows.net/"
		},
		"Linked_Service_AzureDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "carsesync-server.database.windows.net"
		},
		"Linked_Service_AzureDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresync-sql-db"
		},
		"Linked_Service_AzureDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "opsed"
		},
		"Postgres_LinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-flat-mountain-b4bibx6z-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"Postgres_LinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"Postgres_LinkedService_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfcaresyncRG_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"CareSync_KeyVault_LinkedService_properties_typeProperties_baseUrl": {
						"value": "[parameters('CareSync_KeyVault_LinkedService_properties_typeProperties_baseUrl')]"
					},
					"CareSync_LinkedService_properties_typeProperties_url": {
						"value": "[parameters('CareSync_LinkedService_properties_typeProperties_url')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"Linked_Service_AzureDB_properties_typeProperties_server": {
						"value": "[parameters('Linked_Service_AzureDB_properties_typeProperties_server')]"
					},
					"Linked_Service_AzureDB_properties_typeProperties_database": {
						"value": "[parameters('Linked_Service_AzureDB_properties_typeProperties_database')]"
					},
					"Linked_Service_AzureDB_properties_typeProperties_userName": {
						"value": "[parameters('Linked_Service_AzureDB_properties_typeProperties_userName')]"
					},
					"Postgres_LinkedService_properties_typeProperties_server": {
						"value": "[parameters('Postgres_LinkedService_properties_typeProperties_server')]"
					},
					"Postgres_LinkedService_properties_typeProperties_database": {
						"value": "[parameters('Postgres_LinkedService_properties_typeProperties_database')]"
					},
					"Postgres_LinkedService_properties_typeProperties_username": {
						"value": "[parameters('Postgres_LinkedService_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}