{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfcaresyncRG"
		},
		"CareSync_KeyVault_LinkedService_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://CareSyncDB.vault.azure.net/"
		},
		"CareSync_LinkedService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncsprojectstorage.dfs.core.windows.net/"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0928-191302-rof839ul"
		},
		"Linked_Service_AzureDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "carsesync-server.database.windows.net"
		},
		"Linked_Service_AzureDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresync-sql-db"
		},
		"Linked_Service_AzureDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "opsed"
		},
		"Postgres_LinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-flat-mountain-b4bibx6z-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"Postgres_LinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"Postgres_LinkedService_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/CareSync_KeyVault_LinkedService')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('CareSync_KeyVault_LinkedService_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/CareSync_LinkedService')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('CareSync_LinkedService_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DataSet_Parquet')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "CareSync_LinkedService",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folder": {
						"type": "string"
					},
					"container": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": {
							"value": "@dataset().folder",
							"type": "Expression"
						},
						"fileSystem": {
							"value": "@dataset().container",
							"type": "Expression"
						}
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/CareSync_LinkedService')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureDatabricks1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-7405618536307270.10.azuredatabricks.net",
					"accessToken": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "CareSync_KeyVault_LinkedService",
							"type": "LinkedServiceReference"
						},
						"secretName": "Databricks-access-token"
					},
					"existingClusterId": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/CareSync_KeyVault_LinkedService')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Linked_Service_AzureDB')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('Linked_Service_AzureDB_properties_typeProperties_server')]",
					"database": "[parameters('Linked_Service_AzureDB_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('Linked_Service_AzureDB_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "CareSync_KeyVault_LinkedService",
							"type": "LinkedServiceReference"
						},
						"secretName": "azuredb-password"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/CareSync_KeyVault_LinkedService')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Postgres_LinkedService')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "postgresql://neondb_owner: \n@\n/neondb?sslmode=require&channel_binding=require",
				"annotations": [],
				"type": "PostgreSqlV2",
				"typeProperties": {
					"server": "[parameters('Postgres_LinkedService_properties_typeProperties_server')]",
					"port": 5432,
					"database": "[parameters('Postgres_LinkedService_properties_typeProperties_database')]",
					"username": "[parameters('Postgres_LinkedService_properties_typeProperties_username')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "CareSync_KeyVault_LinkedService",
							"type": "LinkedServiceReference"
						},
						"secretName": "postgres-db-pwd"
					},
					"sslMode": 2,
					"authenticationType": "Basic"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/CareSync_KeyVault_LinkedService')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlTable1')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Linked_Service_AzureDB",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Linked_Service_AzureDB')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Postgres_DataSet')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Postgres_LinkedService",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Postgres_LinkedService')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_TO_SILVER_INNER')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read Table Details",
						"description": "This activity is to get the table Id. That table Id will then be used to capture all the details of that table.",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select * from ctrl.table_config where table_id = @{pipeline().parameters.table_id}",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "Set Start Time",
						"description": "This Variable will be used to get the timestamp. It will be used with the file structure and naming conventions.",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "Start Time",
							"value": {
								"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Ingestion-Source-Landing",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Check Data Load Type",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": {
									"value": "SELECT * FROM public.@{activity('Read Table Details').output.firstRow.source_table_name}\n@{\nif(equals(activity('Read Table Details').output.firstRow.load_type,'FULL'),\n    '', concat(\n    'where ' ,activity('Read Table Details').output.firstRow.watermark_column ,' > ','''',variables('watermark_value'),'''')\n    )\n}",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "Postgres_DataSet",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "DataSet_Parquet",
								"type": "DatasetReference",
								"parameters": {
									"folder": {
										"value": "@concat(\n    activity('Read Table Details').output.firstRow.source_system,\n    '/',\n    activity('Read Table Details').output.firstRow.source_table_name,\n    '/',\n    variables('Start Time')\n)",
										"type": "Expression"
									},
									"container": "landing"
								}
							}
						]
					},
					{
						"name": "Landing_to_Bronze",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Ingestion-Source-Landing",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/caresync-repo-folder/caresync-databricks-repo/Initial Landing-Bronze",
							"baseParameters": {
								"source_system": {
									"value": "@activity('Read Table Details').output.firstRow.source_system",
									"type": "Expression"
								},
								"table_name": {
									"value": "@activity('Read Table Details').output.firstRow.bronze_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('Start Time')",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "AzureDatabricks1",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Bronze_to Silver",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Landing_to_Bronze",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/caresync-repo-folder/caresync-databricks-repo/Bronze-Silver",
							"baseParameters": {
								"table_name": {
									"value": "@activity('Read Table Details').output.firstRow.silver_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('Start Time')",
									"type": "Expression"
								},
								"merge_keys": {
									"value": "@coalesce(\n    activity('Read Table Details').output.firstRow.merge_keys,''\n)",
									"type": "Expression"
								},
								"load_type": {
									"value": "@activity('Read Table Details').output.firstRow.load_type",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "AzureDatabricks1",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Update Success",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Bronze_to Silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "Linked_Service_AzureDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "UPDATE ctrl.audit_log set status='SUCCESS', end_time=SYSUTCDATETIME(), records_written=@{activity('Bronze_to Silver').output.runOutput} where adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id='@{pipeline().parameters.table_id}';",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Check Data Load Type",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Read Table Details",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set Start Time",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('Read Table Details').output.firstRow.load_type, 'FULL'))\r\n",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Read Watermark",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "select watermark_value from ctrl.watermark where table_id=@{pipeline().parameters.table_id}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "AzureSqlTable1",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "Store Watermark Value",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Read Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "watermark_value",
										"value": {
											"value": "@activity('Read Watermark').output.firstRow.watermark_value",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "If Condition1",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Bronze_to Silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('Read Table Details').output.firstRow.load_type, 'FULL'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Update Watermark",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "Linked_Service_AzureDB",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update ctrl.watermark\nset watermark_value=SYSUTCDATETIME()\nwhere table_id=@{pipeline().parameters.table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_id": {
						"type": "string",
						"defaultValue": "1"
					},
					"adf_run_id": {
						"type": "string",
						"defaultValue": "a1"
					}
				},
				"variables": {
					"Start Time": {
						"type": "String"
					},
					"watermark_value": {
						"type": "String"
					},
					"merge_keys": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/datasets/Postgres_DataSet')]",
				"[concat(variables('factoryId'), '/datasets/DataSet_Parquet')]",
				"[concat(variables('factoryId'), '/linkedServices/AzureDatabricks1')]",
				"[concat(variables('factoryId'), '/linkedServices/Linked_Service_AzureDB')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/test')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data1",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "select * from public.hospitals",
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "Postgres_DataSet",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "DataSet_Parquet",
								"type": "DatasetReference",
								"parameters": {
									"folder": "test",
									"container": "landing"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Postgres_DataSet')]",
				"[concat(variables('factoryId'), '/datasets/DataSet_Parquet')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_TO_SILVER_MAIN')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read Source Table List",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT  table_id FROM ctrl.table_config where is_active = 1\nand source_system='@{pipeline().parameters.source_system}'",
