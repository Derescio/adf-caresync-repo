{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read Table Status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where run_id = @{pipeline().parameters.adf_run_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare Email Body Header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and Transformation for Care-Sync Process has been completed. See Below"
				}
			},
			{
				"name": "Prepare Email Body Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Body_footer",
					"value": ""
				}
			},
			{
				"name": "Create Email Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Overall Fail Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Email Subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} |  @{\nif(greater(activity('Overall Fail Count').output.firstRow.count,0),'FAILED','SUCCESS')} | CARESYNC MASTER REPO",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Overall Fail Count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}' and status !='SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Logic Apps Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Create Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body Header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read Table Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Logic Apps Body",
					"value": {
						"value": "{\n  \"Subject\":\"@{variables('Email Subject')}\",\n  \"Email\": \"@{pipeline().globalParameters.email}\",\n  \"Body Header\":\"@{variables('body_header')}\",\n  \"Body Footer\":\"@{variables('Body_footer')}\",\n  \"Status Table\": activity('Read Table Status').output.value\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"Body_footer": {
				"type": "String"
			},
			"Email Subject": {
				"type": "String"
			},
			"Logic Apps Body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}